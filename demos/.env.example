# =============================================================================
# AI-900 Demo Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# --- Azure AI Services (Multi-Service / Foundry Resource) ---
# Used by: Hour 1, 3, 4 demos (Vision, Language, Speech, Face, Content Safety)
AZURE_AI_ENDPOINT=https://eastus2.api.cognitive.microsoft.com/
AZURE_AI_KEY=your-foundry-multi-service-key-here

# --- Azure OpenAI Service (East US 2) ---
# Used by: Hour 5 demos (GPT-4o chat, prompt engineering)
AZURE_OPENAI_ENDPOINT=https://eastus2.api.cognitive.microsoft.com/
AZURE_OPENAI_KEY=your-openai-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Azure OpenAI Service (East US) - DALL-E 3 ---
# Used by: Hour 5 demos (image generation)
AZURE_OPENAI_DALLE_ENDPOINT=https://eastus.api.cognitive.microsoft.com/
AZURE_OPENAI_DALLE_KEY=your-dalle-openai-key-here
AZURE_OPENAI_DALLE_DEPLOYMENT=dall-e-3

# --- Azure AI Document Intelligence ---
# Used by: Hour 3 demos (invoice/receipt analysis)
AZURE_DOCINTELL_ENDPOINT=https://eastus2.api.cognitive.microsoft.com/
AZURE_DOCINTELL_KEY=your-document-intelligence-key-here

# --- Azure Custom Vision ---
# Used by: Hour 3 demos (image classification training/prediction)
AZURE_CUSTOMVISION_TRAINING_ENDPOINT=https://eastus2.api.cognitive.microsoft.com/
AZURE_CUSTOMVISION_TRAINING_KEY=your-training-key-here
AZURE_CUSTOMVISION_PREDICTION_ENDPOINT=https://eastus2.api.cognitive.microsoft.com/
AZURE_CUSTOMVISION_PREDICTION_KEY=your-prediction-key-here
